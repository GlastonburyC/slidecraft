node_modules/
dist/
*.local
.DS_Store

# Model weights and their metadata are large and often licence-gated.
*.onnx
*.onnx.json

# Never commit credentials.
.env
.env.*
*token*.txt

# ONNX Runtime wasm assets: vendor build artefacts, recreated by
# scripts/setup-ort.mjs on install. 97 MB that npm already has.
public/ort/

# Slides and their sidecars are data, never source.
*.svs
*.ndpi
*.mrxs
*.scn
*.vms
*.vmu
*.btf
*.bif

# Local toolchain for the export scripts. Multi-gigabyte; see
# scripts/requirements-export.txt for how to recreate it.
.venv/
.venv-export/

# Python bytecode, committed by accident earlier.
__pycache__/
*.py[cod]

# Exported model weights. Gated, licence-bound, and gigabytes each — they are
# produced by scripts/export_onnx.py, never committed.
models/
public/_shot/
